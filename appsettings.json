{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "FileLogging": {
    "Path": "logs",
    "FileNamePrefix": "app",
    "MaxFileSizeBytes": 10485760,
    "MinLevel": "Information"
  },
  "AllowedHosts": "*"
}
